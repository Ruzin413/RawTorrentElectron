{
  "name": "rawtorrent-electron",
  "version": "1.0.0",
  "description": "Cross-platform Torrent Client with .NET Backend",
  "main": "main.js",
  "author": {
    "name": "Rujin Manandhar"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "publish:backend": "dotnet publish RawTorrent/TorServices/TorServices/TorServices.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o ./dist-backend",
    "build": "npm run publish:backend && electron-builder"
  },
  "build": {
    "appId": "com.rawtorrent.app",
    "productName": "RawTorrent",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "dist-installer"
    },
    "win": {
      "target": "nsis",
      "icon": "build/installer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "LICENSE",
      "allowElevation": true,
      "runAfterFinish": true,
      "shortcutName": "RawTorrent"
    },
    "extraResources": [
      {
        "from": "dist-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}