{
  "name": "rawtorrent-electron",
  "version": "1.0.0",
  "description": "Cross-platform Torrent Client with .NET Backend",
  "main": "main.js",
  "author": {
    "name": "Rujin Manandhar"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "register:protocol": "powershell -ExecutionPolicy Bypass -File scripts/register-protocol.ps1",
    "unregister:protocol": "powershell -ExecutionPolicy Bypass -File scripts/register-protocol.ps1 -Unregister",
    "publish:backend:win": "dotnet publish RawTorrent/TorServices/TorServices/TorServices.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o ./dist-backend",
    "publish:backend:linux": "dotnet publish RawTorrent/TorServices/TorServices/TorServices.csproj -c Release -r linux-x64 --self-contained true -p:PublishSingleFile=true -o ./dist-backend",
    "build:win": "npm run publish:backend:win && electron-builder --win",
    "build:linux": "npm run publish:backend:linux && electron-builder --linux"
  },
  "build": {
    "appId": "com.rawtorrent.app",
    "productName": "RawTorrent",
    "artifactName": "${productName}-${os}-${version}.${ext}",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/installer/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/installer/icon.png",
      "category": "Network"
    },
    "protocols": [
      {
        "name": "Magnet Link",
        "schemes": [
          "magnet"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "LICENSE",
      "allowElevation": true,
      "runAfterFinish": true,
      "shortcutName": "RawTorrent",
      "perMachine": true
    },
    "extraResources": [
      {
        "from": "dist-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
